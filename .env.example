# Kamerton: local settings for `kamerton serve`.
# Copy to .env (never committed) and fill in. `kamerton serve` reads .env from
# the current directory at startup (another file: -env-file PATH); variables
# already set in the environment win. Any KAMERTON_* flag variable works here
# (see `kamerton serve -h`).

# Login to the UI and API. Set both to enable it; leave both empty to keep the
# UI open (it then shows a red notice). Setting only one is a startup error.
KAMERTON_AUTH_USER=
KAMERTON_AUTH_PASSWORD=

# Optional session signing key (a long random string, e.g. `openssl rand -hex 32`).
# Empty: derived from the password, so sessions survive restarts and end when
# the password changes.
KAMERTON_AUTH_SECRET=

# Examples of other settings:
# KAMERTON_LISTEN_ADDRESS=:8080
# KAMERTON_DESCRIPTION=testdata/otel-demo/system.yaml
# KAMERTON_PROMETHEUS_URL=http://localhost:9090
